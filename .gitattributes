# Files whose SHA-256 is recorded in a seal must stay byte-identical on every platform
# (no CRLF conversion on Windows checkouts). Other data/*.json are ordinary text, so a
# re-run on Windows shows a diff only if a value changed (compare with
# `git diff --ignore-cr-at-eol`).
data/*.sha256 -text
data/prereg.json -text
data/manifest_nk_device_v1.json -text
data/2026-09-05_nk_v4_verdict.json -text
*.npz binary
*.pdf binary
*.png binary
# The analysis code and gate records hashed inside data/manifest_nk_device_v1.json are kept
# byte-for-byte as sealed (original line endings), so its recorded SHA-256 values verify.
src/nk_stage0_gate.py -text
src/nk_stage0_gate_v2.py -text
src/nk_stage0_gate_v3.py -text
src/nk_stage0_v3R2.py -text
src/nk_falsifier.py -text
src/spectral_lanczos.py -text
data/2026-09-02_nk_stage0_gate_v3.json -text
data/2026-09-02_nk_stage0_v3R2.json -text
# Raw IBM Quantum job records, copied byte for byte from the REST API; their SHA-256 are listed in
# data/heron_gatetp_2026-08-21/README.md and recorded (raw bytes) by src/gate_tp_analysis.py.
data/heron_gatetp_2026-08-21/*.json -text
# Inputs whose SHA-256 a generator records over LF-normalised bytes (blind_addenda.py,
# delta0_reference_mc.py, nk_record/nk_attempt_record.py): checked out with LF line endings,
# so that a plain `sha256sum` of the checked-out file equals the recorded value.
data/blind_instances_public.json text eol=lf
data/blind_labels_sealed.json text eol=lf
data/blind_verdicts.json text eol=lf
data/2026-08-24_blind_harness_score.json text eol=lf
src/blind_classify.py text eol=lf
src/blind_generate.py text eol=lf
src/blind_addenda.py text eol=lf
src/delta0_reference_mc.py text eol=lf
src/hardware_matched_job_L8.py text eol=lf
data/heron_counts_matched_L8_*.json text eol=lf
data/2026-09-05_retention_matched_control.json text eol=lf
data/aer_noiseless_baseline.json text eol=lf
data/_superseded/analytic_coverage_leak.json text eol=lf
src/nk_record/*.py text eol=lf
